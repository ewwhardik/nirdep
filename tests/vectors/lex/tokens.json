{
  "note": "Hand-written token tables for src/lex/lexer.mjs. Each case names its input and the tokens it must produce as kind:value, in order, comments excluded. The interesting rows are the ones where a slash or a brace is ambiguous; the plain rows are here so a rewrite of the scanner cannot pass by getting only the hard cases right. Import-shaped snippets live in this JSON rather than inline in the test file, because tools/verify.mjs reads .mjs files and would count them as real imports.",
  "cases": [
    { "why": "the plain case", "in": "const a = 1;", "out": ["keyword:const", "name:a", "punct:=", "number:1", "punct:;"] },
    { "why": "division, because a name ends an expression", "in": "a / b", "out": ["name:a", "punct:/", "name:b"] },
    { "why": "division after a number", "in": "1 / 2", "out": ["number:1", "punct:/", "number:2"] },
    { "why": "division after a closing bracket", "in": "x[0] / 2", "out": ["name:x", "punct:[", "number:0", "punct:]", "punct:/", "number:2"] },
    { "why": "division after a call", "in": "f(a) / 2", "out": ["name:f", "punct:(", "name:a", "punct:)", "punct:/", "number:2"] },
    { "why": "a regexp after an if head, which a paren-blind lexer reads as division", "in": "if (a) /b/.test(c)", "out": ["keyword:if", "punct:(", "name:a", "punct:)", "regexp:/b/", "punct:.", "name:test", "punct:(", "name:c", "punct:)"] },
    { "why": "a regexp after a while head", "in": "while (a) /b/g.exec(c)", "out": ["keyword:while", "punct:(", "name:a", "punct:)", "regexp:/b/g", "punct:.", "name:exec", "punct:(", "name:c", "punct:)"] },
    { "why": "a regexp after return", "in": "return /x/", "out": ["keyword:return", "regexp:/x/"] },
    { "why": "division after this, which ends an expression", "in": "this / 2", "out": ["keyword:this", "punct:/", "number:2"] },
    { "why": "division after true", "in": "true / 2", "out": ["keyword:true", "punct:/", "number:2"] },
    { "why": "a regexp whose class contains a slash", "in": "x = /[/]/", "out": ["name:x", "punct:=", "regexp:/[/]/"] },
    { "why": "a regexp with an escaped slash", "in": "x = /a\\/b/i", "out": ["name:x", "punct:=", "regexp:/a\\/b/i"] },
    { "why": "a regexp with an escaped bracket, so the class never opens", "in": "x = /\\[/", "out": ["name:x", "punct:=", "regexp:/\\[/"] },
    { "why": "a regexp after a comma", "in": "f(a, /b/)", "out": ["name:f", "punct:(", "name:a", "punct:,", "regexp:/b/", "punct:)"] },
    { "why": "a slash-equals is one punctuator, not a regexp", "in": "a /= 2", "out": ["name:a", "punct:/=", "number:2"] },
    { "why": "a block, so the slash after its brace is a regexp", "in": "if (a) {} /b/.test(c)", "out": ["keyword:if", "punct:(", "name:a", "punct:)", "punct:{", "punct:}", "regexp:/b/", "punct:.", "name:test", "punct:(", "name:c", "punct:)"] },
    { "why": "an object literal, so the slash after its brace divides", "in": "x = {a: 1} / 2", "out": ["name:x", "punct:=", "punct:{", "name:a", "punct::", "number:1", "punct:}", "punct:/", "number:2"] },
    { "why": "a function body is a block", "in": "function f() {} /x/.test(y)", "out": ["keyword:function", "name:f", "punct:(", "punct:)", "punct:{", "punct:}", "regexp:/x/", "punct:.", "name:test", "punct:(", "name:y", "punct:)"] },
    { "why": "a template with no substitution is one token", "in": "x = `abc`", "out": ["name:x", "punct:=", "template:`abc`"] },
    { "why": "a template with one substitution is three", "in": "x = `a${b}c`", "out": ["name:x", "punct:=", "template:`a${", "name:b", "template:}c`"] },
    { "why": "two substitutions produce a middle piece", "in": "`${a}m${b}`", "out": ["template:`${", "name:a", "template:}m${", "name:b", "template:}`"] },
    { "why": "an object literal inside a substitution: the brace must not end the template", "in": "`${ {a: 1} }`", "out": ["template:`${", "punct:{", "name:a", "punct::", "number:1", "punct:}", "template:}`"] },
    { "why": "a template inside a template", "in": "`a${`b${c}d`}e`", "out": ["template:`a${", "template:`b${", "name:c", "template:}d`", "template:}e`"] },
    { "why": "a tagged template", "in": "tag`a${b}`", "out": ["name:tag", "template:`a${", "name:b", "template:}`"] },
    { "why": "an escaped backtick does not close the template", "in": "`a\\`b`", "out": ["template:`a\\`b`"] },
    { "why": "an escaped dollar-brace does not open a substitution", "in": "`a\\${b}`", "out": ["template:`a\\${b}`"] },
    { "why": "the escaped quote does not close the string", "in": "x = 'a\\'b'", "out": ["name:x", "punct:=", "string:'a\\'b'"] },
    { "why": "a trailing backslash-backslash closes normally", "in": "x = 'a\\\\'", "out": ["name:x", "punct:=", "string:'a\\\\'"] },
    { "why": "hex, octal, binary, legacy octal", "in": "0x1F + 0o17 + 0b1010 + 017", "out": ["number:0x1F", "punct:+", "number:0o17", "punct:+", "number:0b1010", "punct:+", "number:017"] },
    { "why": "separators, exponents, bigint, leading dot", "in": "1_000 + 1e-3 + 9n + .5", "out": ["number:1_000", "punct:+", "number:1e-3", "punct:+", "number:9n", "punct:+", "number:.5"] },
    { "why": "a member access on a number, not one long number", "in": "1..toFixed(2)", "out": ["number:1.", "punct:.", "name:toFixed", "punct:(", "number:2", "punct:)"] },
    { "why": "longest-match punctuators", "in": "a >>>= b ?? c ?. d ??= e", "out": ["name:a", "punct:>>>=", "name:b", "punct:??", "name:c", "punct:?.", "name:d", "punct:??=", "name:e"] },
    { "why": "a ternary whose consequent is a decimal, where the longest match would be wrong", "in": "a ?.5 : .3", "out": ["name:a", "punct:?", "number:.5", "punct::", "number:.3"] },
    { "why": "optional call and optional index", "in": "a?.(b)?.[c]", "out": ["name:a", "punct:?.", "punct:(", "name:b", "punct:)", "punct:?.", "punct:[", "name:c", "punct:]"] },
    { "why": "a private field", "in": "class A { #x = 1; }", "out": ["keyword:class", "name:A", "punct:{", "private:#x", "punct:=", "number:1", "punct:;", "punct:}"] },
    { "why": "an arrow body is a block", "in": "x = () => {}", "out": ["name:x", "punct:=", "punct:(", "punct:)", "punct:=>", "punct:{", "punct:}"] },
    { "why": "a name may hold a unicode escape, which is consumed and not decoded", "in": "let a\\u0062 = 1", "out": ["keyword:let", "name:a\\u0062", "punct:=", "number:1"] },
    { "why": "a braced escape inside a name", "in": "let a\\u{62} = 1", "out": ["keyword:let", "name:a\\u{62}", "punct:=", "number:1"] },
    { "why": "a non-ASCII name", "in": "const café = 1", "out": ["keyword:const", "name:café", "punct:=", "number:1"] },
    { "why": "an astral-plane name", "in": "const 𝓍 = 1", "out": ["keyword:const", "name:𝓍", "punct:=", "number:1"] },
    { "why": "a decorator", "in": "@dec class A {}", "out": ["punct:@", "name:dec", "keyword:class", "name:A", "punct:{", "punct:}"] },
    { "why": "the specifier of a static import, which is the whole point of this lexer", "in": "import chalk from 'chalk';", "out": ["keyword:import", "name:chalk", "name:from", "string:'chalk'", "punct:;"] },
    { "why": "a namespace import, where `as` is a name and not a keyword", "in": "import * as semver from \"semver\";", "out": ["keyword:import", "punct:*", "name:as", "name:semver", "name:from", "string:\"semver\"", "punct:;"] },
    { "why": "a named import with a rename", "in": "import { red as r } from 'chalk'", "out": ["keyword:import", "punct:{", "name:red", "name:as", "name:r", "punct:}", "name:from", "string:'chalk'"] },
    { "why": "a dynamic import", "in": "await import('chalk')", "out": ["keyword:await", "keyword:import", "punct:(", "string:'chalk'", "punct:)"] },
    { "why": "a require call", "in": "const c = require('chalk')", "out": ["keyword:const", "name:c", "punct:=", "name:require", "punct:(", "string:'chalk'", "punct:)"] },
    { "why": "an import attribute clause", "in": "import data from './x.json' with { type: 'json' }", "out": ["keyword:import", "name:data", "name:from", "string:'./x.json'", "keyword:with", "punct:{", "name:type", "punct::", "string:'json'", "punct:}"] },
    { "why": "a re-export", "in": "export { a } from './b.mjs'", "out": ["keyword:export", "punct:{", "name:a", "punct:}", "name:from", "string:'./b.mjs'"] },
    { "why": "a label reads as a name, which is why the resolver checks positions", "in": "outer: for (;;) break outer;", "out": ["name:outer", "punct::", "keyword:for", "punct:(", "punct:;", "punct:;", "punct:)", "keyword:break", "name:outer", "punct:;"] }
  ],
  "errors": [
    { "in": "x = 'abc", "code": "UNTERMINATED_STRING" },
    { "in": "x = 'a\nb'", "code": "UNTERMINATED_STRING" },
    { "in": "x = `abc", "code": "UNTERMINATED_TEMPLATE" },
    { "in": "x = `a${b}", "code": "UNTERMINATED_TEMPLATE" },
    { "in": "/* abc", "code": "UNTERMINATED_COMMENT" },
    { "in": "x = /abc", "code": "UNTERMINATED_REGEXP" },
    { "in": "x = /a\nb/", "code": "UNTERMINATED_REGEXP" },
    { "in": "x = 3in", "code": "BAD_NUMBER" },
    { "in": "x = 1_000abc", "code": "BAD_NUMBER" }
  ]
}
