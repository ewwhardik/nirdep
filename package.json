{
  "name": "nirdep",
  "version": "0.1.0",
  "description": "Delete your dependencies. A scope-aware JavaScript codemod and a standard-library runtime that replace the most-installed packages on npm. Published by Nastik AI. Developed by Hardik.",
  "license": "MIT",
  "author": "Hardik",
  "publisher": "Nastik AI",
  "type": "module",
  "bin": {
    "nirdep": "./bin/nirdep.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./runtime/colour": "./src/runtime/colour.mjs",
    "./runtime/args": "./src/runtime/args.mjs",
    "./runtime/semver": "./src/runtime/semver.mjs"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.mjs\"",
    "verify": "node tools/verify.mjs",
    "repro": "node tools/build.mjs --repro",
    "conformance": "node bin/nirdep.mjs conformance"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "STDLIB.md",
    "LICENSE",
    ".zero-dep.toml"
  ],
  "keywords": [
    "zero-dependency",
    "codemod",
    "standard-library",
    "supply-chain"
  ],
  "dependencies": {},
  "devDependencies": {},
  "peerDependencies": {},
  "optionalDependencies": {}
}
