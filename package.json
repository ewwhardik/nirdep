{
  "name": "nirdep",
  "version": "0.1.0",
  "description": "Delete your dependencies. A scope-aware JavaScript codemod and a standard-library runtime that replace the most-installed packages on npm. Published by Nastik AI. Developed by Sai Ram Dash (Hardik).",
  "license": "MIT",
  "author": "Sai Ram Dash (Hardik)",
  "publisher": "Nastik AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ewwhardik/nirdep.git"
  },
  "homepage": "https://ewwhardik.github.io/nirdep/",
  "bugs": "https://github.com/ewwhardik/nirdep/issues",
  "type": "module",
  "bin": {
    "nirdep": "./bin/nirdep.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./runtime/colour": "./src/runtime/colour.mjs",
    "./runtime/args": "./src/runtime/args.mjs",
    "./runtime/semver": "./src/runtime/semver.mjs",
    "./runtime/glob": "./src/runtime/glob.mjs",
    "./runtime/collect": "./src/runtime/collect.mjs"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.mjs\"",
    "verify": "node tools/verify.mjs",
    "repro": "node tools/build.mjs --repro",
    "page": "node tools/playground.mjs",
    "demo": "node bin/nirdep.mjs demo",
    "conformance": "node bin/nirdep.mjs conformance"
  },
  "files": [
    "bin",
    "src",
    "action.yml",
    "README.md",
    "STDLIB.md",
    "SECURITY.md",
    "LICENSE",
    ".zero-dep.toml"
  ],
  "keywords": [
    "zero-dependency",
    "codemod",
    "standard-library",
    "supply-chain"
  ],
  "dependencies": {},
  "devDependencies": {},
  "peerDependencies": {},
  "optionalDependencies": {}
}
